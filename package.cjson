{
    "author": "Priyank Parashar",
    "engines": {
        // `>=24.2.0` is required because `index.js` uses `import.meta.main`, which became stable in Node.js 24.2.0.
        "node": ">=24.2.0"
    },
    "bin": {
        "package-cjson": "./index.js"
    },
    "bugs": {
        "url": "https://github.com/webextensions/package-cjson/issues"
    },
    "dependencies": {
        "chalk": "^6.0.0",                 // Colorful console
        "cjson": "^0.5.0",                 // Parse CJSON
        "deep-equal": "^2.2.3",            // Compare JSON objects
        "detect-indent": "^7.0.2",
        "difflet": "^1.0.1",               // Colorful diff
        "helpmate": "^1.9.0",              // Some utility functions
        "json-stable-stringify": "^1.3.0", // Predictable JSON stringify
        "jsonfile": "^6.2.1",              // Operate on json files
        "note-down": "^2.5.0",             // Logging
        "yargs": "^18.1.0"                 // Processing of command-line arguments
    },
    "description": "Add comments in package.cjson/package.json.js/package.json.ts in Node JS project; Generate package.json from it; Compare with package.json",
    "devDependencies": {
        "@eslint/js": "^10.0.1",           // ESLint recommended config (flat config)
        "eslint": "^10.8.1",
        "execa": "^10.0.1",
        "globals": "^17.9.0",              // Predefined global identifiers (e.g. Node.js globals) for ESLint
        "vitest": "^4.1.10"
    },
    "homepage": "https://github.com/webextensions/package-cjson#readme",
    "keywords": [
        "comments",
        "package.cjson",
        "package.json.js",
        "package.json.ts",
        "generate",
        "package.json",
        "compare"
    ],
    "license": "MIT",
    "main": "index.js",
    "name": "package-cjson",
    "preferGlobal": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/webextensions/package-cjson.git"
    },
    "scripts": {
        "version": "./scripts/build-and-release/prepare-version.sh",
        "start": "node index.js",
        "test": "npm run eslint && npm run vitest",

        "eslint": "eslint .",
        "vitest": "vitest run",

        "compare": "node index.js --mode compare",
        "compare-silent": "node index.js --mode compare --silent-on-compare-success",
        "generate-package-json": "node index.js --mode generate-package-json",
        "update": "node index.js --mode update",
        "update-and-generate-package-json": "node index.js --mode update-and-generate-package-json"
    },
    "version": "3.1.0"
}
